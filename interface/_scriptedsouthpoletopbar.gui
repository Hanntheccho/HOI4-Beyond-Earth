@topbarwin_x_pos = 0
@topbarwin_y_pos = 120
@topbarwin_width = 550
@topbarwin_height = 920
@topbarwin_anim_time = 300
guiTypes = {
	containerWindowType = {
		name = "sectors_button_window"
		clipping = no
		buttonType = {
			name = "sectors_button"
			position = { x = 20 y = 460 }
			quadTextureSprite = GFX_topbar_button
			font = Arialsmallcap
			text = SECTORSTOPBARBUTTON
			clicksound = click_close
			oversound = ui_menu_over
			pdx_tooltip = help_southpole_sector_price
		}
	}
	containerWindowType = {
		name = "south_pole_stuff"
		position = { x = -600 y = @topbarwin_y_pos }
		show_position = { x = @topbarwin_x_pos y = @topbarwin_y_pos }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = @topbarwin_anim_time
		size = { width = @topbarwin_width height = @topbarwin_height }
		clipping = no
		hide_sound = menu_close_window
		show_sound = menu_open_window
		moveable = yes
		click_to_front = yes
		#verticalScrollbar = right_vertical_slider_offset
		background = { quadTextureSprite = GFX_tiled_default_bg }
		background = { quadTextureSprite = GFX_antarctic_sectors_bg }
		containerWindowType = {
			name = "header"
			size = { width = 515 height = 42 }
			background = { quadTextureSprite = GFX_tiled_top }
		}
		instantTextboxType = {
			name = "sectors_title"
			font = Arialcap
			position = { x = -180 y = 8 }
			text = SECTORS_VIEW_TITLE
			maxWidth = 360
			maxHeight = 36
			format = center
			orientation = CENTER_UP
		}
		buttonType = {
			name = "south_pole_close"
			position = { x = -21 y = 21 }
			orientation = UPPER_RIGHT
			quadTextureSprite = GFX_close
			clicksound = click_close
			shortcut = "ESCAPE"
			centerposition = yes
		}
		iconType = {
			name = "help"
			position = { x = -56 y = 21 }
			quadTextureSprite = GFX_warning
			pdx_tooltip = help_southpole_sector_price
			orientation = UPPER_RIGHT
			centerposition = yes
		}
		iconType = {
			name = "antarctic_sectors_icon"
			spriteType = GFX_antarctic_sectors_icon
			position = { x = 0 y = 250 }
			pdx_tooltip = help_southpole_sector_price
			orientation = CENTER_UP
			centerposition = yes
		}
		containerWindowType = {
			name = "south_pole_sectors_list"
			position = { x = 20 y = 480 }
			size = { width = 535 height = 96% }
			clipping = no
			background = { quadTextureSprite = GFX_tiled_null }
			@sector_button_x_size = 510
			@sector_button_y_size = 42
			@sector_button_gfx = GFX_tiling_button_light
			@sector_button_font = Arialsmallcap
			containerWindowType = {
				name = "sector_1"
				size = { width = @sector_button_x_size height = @sector_button_y_size }
				buttonType = { name = "antarctic_sectors_selection_1" spriteType = GFX_tiling_button_light size = { x = @sector_button_x_size y = @sector_button_y_size } pdx_disabled_tooltip = antarctic_sectors_selection_disabled }
				buttonType = { name = "leave_sector_1" spriteType = GFX_cancel position = { x = 474 y = 6 } }
				iconType = { name = "type" spriteType = GFX_topbar_icons frame = 4 pdx_tooltip = sector_add_mils }
				iconType = { name = "flag_sector_1" quadTextureSprite = GFX_trade_entry_flag position = { x = 39 y = -6 } }
				instantTextBoxType = { name = "text" position = { x = 120 y = 10 } text = "sector_1_text" font = @sector_button_font maxWidth = 220 maxHeight = 20 fixedsize = yes alwaystransparent = yes }
				instantTextBoxType = { name = "cost" position = { x = -264 y = 12 } text = "sector_1_cost_text" font = Arial16 maxWidth = 220 maxHeight = 20 fixedsize = yes format = right orientation = UPPER_RIGHT alwaystransparent = yes }
			}
			containerWindowType = {
