guiTypes = {
	#country event win
	@country_event_win_width = 670
	containerWindowType = {
		name = "EventWindow"
		size = { width = @country_event_win_width height = 1 }
		moveable = yes
		click_to_front = yes
		orientation = CENTER
		origo = center
		clipping = no
		show_sound = event_popup
		hide_sound = menu_close_window
		background = {
			spriteType = GFX_tiled_null
		}
		containerWindowType = {
			name = "top_Window"
			size = { width = @country_event_win_width height = 42 }
			background = {
				spriteType = GFX_tiling_button_light
				alwaystransparent = yes
			}
			containerWindowType = {
				name = "header"
				size = { width = 100%% height = 42 }
				background = {
					quadTextureSprite = GFX_tiled_top
				}
			}
			instantTextboxType = {
				name = "Title"
				position = { x = -280 y = 8 }
				font = "Arialcap"
				text = "STATE_NAME_TEST"
				maxWidth = 560
				maxHeight = 20
				format = center
				orientation = CENTER_UP
				fixedsize = yes
			}
			buttonType = {
				name = "btn_minimize"
				position = { x = -21 y = 21 }
				orientation = UPPER_RIGHT
				quadTextureSprite = GFX_close
				clicksound = click_close
				shortcut = "ESCAPE"
				centerposition = yes
				pdx_tooltip = "MINIMIZE_EVENT"
			}
		}
		containerWindowType = {
			name = "midsection"
			position = { x = 0 y = 35 }
			size = { width = @country_event_win_width height = 1 }
			background = {
				quadTextureSprite = GFX_tiled_default_bg
				alwaystransparent = yes
			}
			instantTextBoxType = {
				name = "Description"
				position = { x = 25 y = 15 }
				font = "Arial16"
				text = "Long text here!"
				maxWidth = 620
				maxHeight = 1
			}
		}
		containerWindowType = {
			name = "bottom_Window"
			size = { width = @country_event_win_width height = 240 }
			background = {
				spriteType = GFX_tiled_default_bg
				alwaystransparent = yes
				position = { x = 0 y = -7 }
			}
			@event_option_width = 632
			@event_option_height = 50
			gridBoxType = {
				name = "options_grid"
				position = { x = 20 y = 13 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = @event_option_width height = @event_option_height }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}

			#debug
			iconType = {
				name = "event_picture"
				spriteType = GFX_report_event_001
				alwaystransparent = yes
				hide = yes
			}
		}
	}

	#event option entry item
	containerWindowType = {
		name = "event_option_entry"
		size = { width = @event_option_width height = @event_option_height }
		background = {
			name = "event_option_background"
			spriteType = GFX_tiling_button
		}
		instantTextBoxType = {
			name = "Name"
			position = { x = 25 y = 5 }
			font = "Arialsmallest"
			maxWidth = 580
			maxHeight = 40
			format = center
			vertical_alignment = center
			fixedsize = yes
			alwaystransparent = yes
		}
	}

	#news event win
	containerWindowType = {
		name = "EventWindow_News"
		size = { width = 535 height = 702 }
		moveable = yes
		orientation = CENTER
		origo = center
		show_sound = world_news_effect
		hide_sound = menu_close_window
		clipping = no
		background = {
			spriteType = GFX_event_news_bg
		}
		background = {
			spriteType = GFX_event_news_bg_black
		}

		containerWindowType = {
			name = "news_animation"
			size = { width = 528 height = 694 }
			clipping = yes
			position = { x = 7 y = 11 }
			iconType = 	{
				name = "newsnewsnews"
				spriteType = GFX_newsnewsnews
				alwaystransparent = yes
			}
			iconType = 	{
				name = "newsnewsnews2"
				spriteType = GFX_newsnewsnews2
				position = { x = 0 y = 640 }
				alwaystransparent = yes
			}
		}

		containerWindowType = {
			name = "top_Window"
			position = { x = 7 y = -12 }
			size = { width = 581 height = 121 }
			instantTextBoxType = {
				name = "detail"
				position = { x = 16 y = 240 }
				font = "Arialsmallest"
				text = "▀▀▀  ▀▀▀▀▀▀▀▀▀  ▀▀▀▀▀▀"
				maxWidth = 5
				maxHeight = 400
			}
			containerWindowType = {
				name = "Background"
				size = { width = 514 height = 415 }

				background = {
					name = "Background"
					quadTextureSprite = GFX_tiled_alpha
					position = { x = 7 y = 240 }
					alwaystransparent = yes
				}
			}
			iconType = {
				name = "event_picture"
				spriteType = GFX_unknown_event_picture
				position = { x = 6 y = 83 }
				alwaystransparent = yes
			}
			iconType = {
				name = "event_picture_overlay"
				spriteType = GFX_event_news_pic_overlay_mod
				position = { x = 6 y = 83 }
				alwaystransparent = yes
			}
			iconType = {
				name = "event_title_bg"
				spriteType = GFX_event_title_bg
				position = { x = 100 y = 168 }
				alwaystransparent = yes
			}
			instantTextboxType = {
				name = "Title"
				position = { x = 139 y = 152 }
				font = "Arialcap"
				text = "STATE_NAME_TEST"
				maxWidth = 375
				maxHeight = 80
				format = right
				fixedsize = yes
				vertical_alignment = bottom
			}

			#todo
			buttonType = {
				name = "btn_minimize"
				position = { x = -77 y = 101 }
				spriteType = GFX_close
				orientation = UPPER_RIGHT
				clicksound = click_default
				shortcut = "ESCAPE"
				centerposition = yes
			}
		}

		containerWindowType = {
			name = "midsection"
			position = { x = -20 y = 0 }
			size = { width = 500 height = 385 }
			instantTextBoxType = {
				name = "Description"
				position = { x = 58 y = 239 }
				font = "Arial16"
				borderSize = { x = 5 y = 0 }
				text = "Long text here!"
				maxWidth = 467
				maxHeight = 395
				scrollbarType = standardtext_slider
			}
		}

		#todo
		containerWindowType = {
			name = "bottom_Window"
			position = { x = 7 y = 228 }
			size = { width = 612 height = 405 }
			clipping = yes
			gridBoxType = {
				name = "options_grid"
				position = { x = -60 y = 10000 }
				size = { width = 300 height = 30 }
				slotsize = { width = 300 height = 47 }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}
		}
	}
}
