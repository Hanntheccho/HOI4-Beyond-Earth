@topbarwin_x_pos = 0
@topbarwin_y_pos = 120
@topbarwin_width = 550
@topbarwin_height = 920
@topbarwin_anim_time = 300
guiTypes = {
	extendedScrollbarType = {
		name = "right_vertical_slider_offset"
		position = { x = 24 y = 0 }
		size = { width = 18 height = 18 }
		startValue = 0
		orientation = upper_right
		origo = upper_right
		slider = {
			name = "Slider"
			quadTextureSprite = GFX_scroll_drager
			position = { x = -2 y = 0 }
		}
		track = {
			name = "Track"
			quadTextureSprite = GFX_scroll_track
			alwaystransparent = yes
		}
		decreaseButton = {
			name = "Decrease"
			quadTextureSprite = GFX_scroll_up
			position = { x = -2 y = 0 }
		}
		increaseButton = {
			name = "Increase"
			quadTextureSprite = GFX_scroll_down
			position = { x = -20 y = -16 }
		}
	}
}

