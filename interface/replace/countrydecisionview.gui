@topbarwin_x_pos = 0
@topbarwin_y_pos = 120
@topbarwin_width = 550
@topbarwin_height = 920
@topbarwin_anim_time = 300
guiTypes = {
	containerWindowType = {
		name = "countrydecisionview"
		position = { x = -600 y = @topbarwin_y_pos }
		show_position = { x = @topbarwin_x_pos y = @topbarwin_y_pos }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = @topbarwin_anim_time
		size = { width = @topbarwin_width height = @topbarwin_height }
		clipping = no
		hide_sound = menu_close_window
		show_sound = menu_open_window
		moveable = yes
		click_to_front = yes
		#verticalScrollbar = right_vertical_slider_offset
		background = {
			quadTextureSprite = GFX_tiled_default_bg
		}
		background = {
			quadTextureSprite = GFX_pol_view_bg_large
		}
		containerWindowType = {
			name = "header"
			size = { width = 100%% height = 42 }
			background = {
				quadTextureSprite = GFX_tiled_top
			}
		}
		instantTextboxType = {
			name = "decisionview_title"
			font = "Arialcap"
			position = { x = -180 y = 8 }
			text = "DECISIONVIEW_TITLE"
			maxWidth = 360
			maxHeight = 36
			format = center
			orientation = CENTER_UP
		}
		buttonType = {
			name = "close_button"
			position = { x = -21 y = 21 }
			orientation = UPPER_RIGHT
			quadTextureSprite = GFX_close
			clicksound = click_close
			shortcut = "ESCAPE"
			centerposition = yes
		}

		@decision_grid_width = 510
		@decision_default_height = 42
		containerWindowType = {
			name = "decision_grid_container"
			position = { x = 15 y = 35 }
			size = { width = -1 height = -10 }
			verticalScrollbar = right_vertical_slider_offset
			scroll_wheel_factor = 100
			smooth_scrolling = yes
			margin = {
				top = 20
				bottom = 20
			}
			background = {
				quadTextureSprite = GFX_tiled_null
			}
			gridboxtype = {
				name = "decision_grid"
				size = { width = 520 height = 100%% }
				slotsize = { width = @decision_grid_width height = 1 }
				max_slots_horizontal = 1
			}
		}
	}

	#decisions win header
	containerWindowType = {
		name = "event_header"
		size = { width = @decision_grid_width height = 55 }
		clipping = no
		background = {
			quadTextureSprite = GFX_tiling_button_light
			alwaystransparent = yes
		}

		#debug
		iconType = {
			name = "icon_header_bg"
			spriteType = GFX_event_header_bg
			hide = yes
		}

		containerWindowType = {
			name = "news_checkbox_window"
			position = { x = 10 y = 12 }
			instantTextboxType = {
				name = "title"
				position = { x = 35 y = 6 }
				font = "Arialsmallest"
				text = "POPUP_NEWS"
				maxWidth = 200
				maxHeight = 20
			}
			checkBoxType = {
				name = "popup_news_checkbox"
				quadTextureSprite = GFX_checkbox
				clicksound = decisions_ui_button
				pdx_tooltip = NEWS_EVENTS
			}
		}
		containerWindowType = {
			name = "event_checkbox_window"
			position = { x = 180 y = 12 }
			instantTextboxType = {
				name = "title"
				position = { x = 35 y = 6 }
				font = "Arialsmallest"
				text = "POPUP_EVENTS"
				maxWidth = 200
				maxHeight = 20
			}
			checkBoxType = {
				name = "popup_events_checkbox"
				quadTextureSprite = GFX_checkbox
				clicksound = decisions_ui_button
				pdx_tooltip = COUNTRY_EVENT
			}
		}
		containerWindowType = {
			name = "minor_event_checkbox_window"
			position = { x = 350 y = 12 }
			instantTextboxType = {
				name = "title"
				position = { x = 35 y = 6 }
				font = "Arialsmallest"
				text = "POPUP_MINOR_EVENTS"
				maxWidth = 200
				maxHeight = 20
			}
			checkBoxType = {
				name = "popup_minor_events_checkbox"
				quadTextureSprite = GFX_checkbox
				clicksound = decisions_ui_button
				pdx_tooltip = MINOR_EVENT_POPUP_CHECKBOX_TOOLTIP
			}
		}
	}

	#decisions win category header
	containerWindowType = {
		name = "category_header"
		size = { width = @decision_grid_width height = @decision_default_height }
		clipping = no
		background = {
			quadTextureSprite = GFX_tiling_button_light
		}
		background = {
			quadTextureSprite = GFX_tiled_top
		}
		buttonType = {
			name = "icon_header_bg"
			spriteType = GFX_tiled_null
			size = { x = @decision_grid_width y = @decision_default_height }
			clicksound = decisions_ui_tab
		}
		iconType = {
			name = "icon"
			spriteType = GFX_decision_category_generic
		}
		instantTextboxType = {
			name = "name_text"
			position = { x = -200 y = 8 }
			font = Arialcap
			maxWidth = 400
			maxHeight = 100
			format = center
			orientation = CENTER_UP
			fixedsize = yes
		}
		buttonType = {
			name = "track_decisions_checkbox"
			position = { x = -56 y = 21 }
			quadTextureSprite = GFX_checkbox_light
			clicksound = decisions_ui_button
			frame = 2
			orientation = UPPER_RIGHT
			centerposition = yes
		}
		buttonType = {
			name = "category_collapse_btn"
			position = { x = -21 y = 21 }
			quadTextureSprite = GFX_minimize_2frames
			clicksound = click_default
			frame = 1
			orientation = UPPER_RIGHT
			centerposition = yes
		}
	}

	#decisions win category desc
	containerWindowType = {
		name = "decision_category_desc"
		size = { width = @decision_grid_width height = 0 }
		clipping = no
		background = {
			quadTextureSprite = GFX_tiled_alpha
			clicksound = click_default
		}

		#todo
		iconType = {
			name = "picture"
			spriteType = GFX_d_category_empty_picture
			alwaystransparent = yes
		}

		instantTextboxType = {
			name = "full_text"
			font = "Arial16"
			borderSize = { x = 26 y = 26 }
			maxWidth = @decision_grid_width
		}
		instantTextboxType = {
			name = "short_text"
			font = "Arial16"
			borderSize = { x = 26 y = 26 }
			maxWidth = @decision_grid_width
		}

		#???
		OverlappingElementsBoxType = {
			name = "custom_icons"
			size = { x = @decision_grid_width y = 32 }
			format = center
			spacing = 1.0
			orientation = LEFT
		}
	}

	#decisions win event item entry
	containerWindowType = {
		name = "event_item"
		size = { width = @decision_grid_width height = @decision_default_height }
		clipping = no
		buttonType = {
			name = "btn_bg"
			spriteType = GFX_tiling_button_light
			size = { x = @decision_grid_width y = @decision_default_height }
			clicksound = click_default
		}
		iconType = {
			name = "event_type_icon"
			spriteType = GFX_warning_2frames
			frame = 1
		}
		instantTextboxType = {
			name = "name_text"
			position = { x = 46 y = 10 }
			font = "Arialsmallcap"
			text = "event name"
			maxWidth = 370
			maxHeight = 20
			multiline = no
			fixedsize = yes
		}
		instantTextboxType = {
			name = "timer_text"
			position = { x = 396 y = 10 }
			font = "Arialsmallcap"
			text = "999"
			maxWidth = 100
			maxHeight = 20
			format = right
		}
	}

	#decisions win decision item entry
	containerWindowType = {
		name = "decision_item"
		size = { width = @decision_grid_width height = @decision_default_height }
		clipping = no
		iconType = {
			name = "btn_bg"
			spriteType = GFX_decision_item_bg
		}
		iconType = {
			name = "btn_progress_good"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_good
		}
		iconType = {
			name = "btn_progress_bad"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_bad
		}
		iconType = {
			name = "icon"
			position = { x = 20 y = 20 }
			spriteType = GFX_decision_unknown
			centerposition = yes
		}
		instantTextboxType = {
			name = "name_text"
			position = { x = 40 y = 11 }
			font = "Arialsmallestcap"
			maxWidth = 350
			maxHeight = 20
			multiline = no
		}
		iconType = {
			name = "target_flag"
			position = { x = 4 y = -7 }
			quadTextureSprite = GFX_construction_flag
		}

		#debug
		iconType = {
			name = "target_flag_frame"
			quadTextureSprite = GFX_small_flag_frame_thin2
			hide = yes
		}

		instantTextboxType = {
			name = "cost_and_timer_text"
			position = { x = 328 y = 11 }
			font = "Arialsmallestcap"
			text = "999"
			maxWidth = 140
			maxHeight = 35
			format = right
		}
		buttonType = {
			name = "track_decision_checkbox"
			position = { x = -21 y = 21 }
			quadTextureSprite = GFX_checkbox
			clicksound = click_default
			orientation = UPPER_RIGHT
			centerposition = yes
		}
		buttonType = {
			name = "btn_select"
			spriteType = GFX_decision_select_icon_strip
			clicksound = decisions_ui_checkbox
			frame = 2
			alwaystransparent = yes
		}
	}

	containerWindowType = {
		name = "targeted_decision_item"
		size = { width = @decision_grid_width height = @decision_default_height }
		clipping = no
		iconType = {
			name = "btn_bg"
			spriteType = GFX_decision_item_bg
		}
		iconType = {
			name = "btn_progress_good"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_good
		}
		iconType = {
			name = "btn_progress_bad"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_bad
		}
		iconType = {
			name = "target_flag"
			position = { x = 4 y = -7 }
			quadTextureSprite = GFX_construction_flag
		}
		iconType = {
			name = "icon"
			position = { x = 20 y = 20 }
			spriteType = GFX_decision_unknown
			centerposition = yes
		}
		instantTextboxType = {
			name = "name_text"
			position = { x = 40 y = 11 }
			font = "Arialsmallestcap"
			maxWidth = 350
			maxHeight = 20
			multiline = no
		}

		#todo
		iconType = {
			name = "timer_icon"
			position = { x = 10000 y = 15 }
			spriteType = GFX_decision_timer_icon_strip
			frame = 1
			centerposition = yes
		}

		instantTextboxType = {
			name = "timer_text"
			position = { x = 328 y = 11 }
			font = "Arialsmallestcap"
			text = "999"
			maxWidth = 140
			maxHeight = 35
			format = right
		}
		instantTextboxType = {
			name = "cost_and_timer_text"
			position = { x = 328 y = 11 }
			font = "Arialsmallestcap"
			text = "999"
			maxWidth = 140
			maxHeight = 35
			format = right
		}
		buttonType = {
			name = "track_decision_checkbox"
			position = { x = -21 y = 21 }
			quadTextureSprite = GFX_checkbox
			clicksound = click_default
			orientation = UPPER_RIGHT
			centerposition = yes
		}
		buttonType = {
			name = "btn_select"
			spriteType = GFX_decision_select_icon_strip
			clicksound = decisions_ui_checkbox
			frame = 2
		}
	}

	containerWindowType = {
		name = "timed_decision_item"
		size = { width = @decision_grid_width height = @decision_default_height }
		clipping = no
		iconType = {
			name = "btn_bg"
			spriteType = GFX_decision_item_bg
		}
		iconType = {
			name = "btn_progress_good"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_good
		}
		iconType = {
			name = "btn_progress_bad"
			position = { x = 10000 y = 37 }
			spriteType = GFX_decision_item_progress_bad
		}
		iconType = {
			name = "icon"
			position = { x = 20 y = 20 }
			spriteType = GFX_decision_unknown
			centerposition = yes
		}
		instantTextboxType = {
			name = "name_text"
			position = { x = 40 y = 11 }
			font = "Arialsmallestcap"
			maxWidth = 350
			maxHeight = 20
			multiline = no
		}
		iconType = {
			name = "target_flag"
			position = { x = 4 y = -7 }
			quadTextureSprite = GFX_construction_flag
		}

		#debug
		iconType = {
			name = "target_flag_frame"
			quadTextureSprite = GFX_small_flag_frame_thin2
			hide = yes
		}

		#todo
		iconType = {
			name = "timer_icon"
			position = { x = 10000 y = 10 }
			spriteType = GFX_decision_timer_icon_strip
			frame = 1
			centerposition = yes
		}

		instantTextboxType = {
			name = "timer_text"
			position = { x = 356 y = 11 }
			font = "Arialsmallestcap"
			text = "999"
			maxWidth = 140
			maxHeight = 35
			format = right
		}
		instantTextboxType = {
			name = "cost_and_timer_text"
			position = { x = 356 y = 11 }
			font = "Arialsmallestcap"
			text = "999"
			maxWidth = 140
			maxHeight = 35
			format = right
		}
		buttonType = {
			name = "btn_select"
			spriteType = GFX_decision_select_icon_strip
			clicksound = decisions_ui_checkbox
			frame = 2
			alwaystransparent = yes
		}
	}
}
