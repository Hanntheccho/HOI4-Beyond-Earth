@topbarwin_x_pos = 0
@topbarwin_y_pos = 120
@topbarwin_width = 550
@topbarwin_height = 920
@topbarwin_anim_time = 300
guiTypes = {
	containerWindowType = {
		name = "countrytradeview"
		position = { x = -600 y = @topbarwin_y_pos }
		show_position = { x = @topbarwin_x_pos y = @topbarwin_y_pos }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = @topbarwin_anim_time
		size = { width = @topbarwin_width height = @topbarwin_height }
		clipping = no
		hide_sound = menu_close_window
		show_sound = menu_open_window
		moveable = yes
		click_to_front = yes
		#verticalScrollbar = right_vertical_slider_offset
		background = {
			quadTextureSprite = GFX_tiled_default_bg
		}
		background = {
			quadTextureSprite = GFX_trade_view_bg_large
		}
		containerWindowType = {
			name = "header"
			size = { width = 515 height = 42 }
			background = {
				quadTextureSprite = GFX_tiled_top
			}
		}
		instantTextboxType = {
			name = "trade_title"
			font = Arialcap
			position = { x = -180 y = 8 }
			text = "TRADE_TRADE"
			maxWidth = 360
			maxHeight = 36
			format = center
			orientation = CENTER_UP
		}
		buttonType = {
			name = "close_button"
			position = { x = -21 y = 21 }
			orientation = UPPER_RIGHT
			quadTextureSprite = GFX_close
			clicksound = click_close
			shortcut = "ESCAPE"
			centerposition = yes
		}
		iconType = {
			name = "trade_header"
			spriteType = GFX_warning
			position = { x = -56 y = 21 }
			orientation = UPPER_RIGHT
			centerposition = yes
		}

		#debug
		instantTextboxType = {
			name = "factories_total"
			position = { x = -10000 y = 0 }
			font = hoi_18mbs
			maxWidth = 45
			maxHeight = 18
			alwaystransparent = yes
			hide = yes
		}
		instantTextboxType = {
			name = "factories_used"
			position = { x = -10000 y = 0 }
			font = hoi_18mbs
			maxWidth = 120
			maxHeight = 18
