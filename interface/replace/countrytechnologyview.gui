@topbarwin_x_pos = 0
@topbarwin_y_pos = 120
@topbarwin_width = 550
@topbarwin_height = 920
@topbarwin_anim_time = 300
guiTypes = {
	containerWindowType = {
		name = "countrytechnologyview"
		position = { x = -600 y = @topbarwin_y_pos }
		show_position = { x = @topbarwin_x_pos y = @topbarwin_y_pos }
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = @topbarwin_anim_time
		size = { width = @topbarwin_width height = @topbarwin_height }
		clipping = no
		hide_sound = menu_close_window
		show_sound = menu_open_window
		moveable = yes
		click_to_front = yes
		#verticalScrollbar = right_vertical_slider_offset
		background = { quadTextureSprite = GFX_tiled_default_bg }
		background = { quadTextureSprite = GFX_research_view_bg_large }
		containerWindowType = {
			name = "header"
			size = { width = 480 height = 42 }
			background = { quadTextureSprite = GFX_tiled_top }
		}
		instantTextboxType = {
			name = "research_title"
			font = Arialcap
			position = { x = -180 y = 8 }
			text = "RESEARCH_RESEARCH"
			maxWidth = 360
			maxHeight = 36
			format = center
			orientation = CENTER_UP
		}
		buttonType = {
			name = "close_button"
			position = { x = -21 y = 21 }
			orientation = UPPER_RIGHT
			quadTextureSprite = GFX_close
			clicksound = click_close
			shortcut = "ESCAPE"
			centerposition = yes
		}

		#research tabs
		containerWindowType = {
			name = "tabs"
			position = { x = 20 y = 50 }
			size = { width = 100%% height = 30 }
			buttonType = {
				name = "research_slots_tab"
				quadTextureSprite = GFX_tiling_button_light
				size = { x = 240 y = 40 }
				text = "RESEARCH_TAB_SLOTS"
				font = Arialsmallcap
				clicksound = click_default
			}
			buttonType = {
				name = "facilities_tab"
				position = { x = 240 y = 0 }
				quadTextureSprite = GFX_tiling_button_light
				size = { x = 270 y = 40 }
				text = "RESEARCH_TAB_FACILITIES"
				font = Arialsmallcap
				clicksound = click_default
			}
		}

		#research slots win top
		containerWindowType = {
			name = "research_slots"
			size = { width = 100%% height = -1 }
			containerWindowType = {
				name = "research_win_top"
				size = { width = 100% height = 100% }
				iconType = {
					name = "research_speed_icon"
					spriteType = GFX_warning_red
					position = { x = -91 y = 21 }
					orientation = UPPER_RIGHT
					centerposition = yes
				}
				iconType = {
					name = "focus_bonuses"
					spriteType = GFX_info
					position = { x = -56 y = 21 }
					orientation = UPPER_RIGHT
					centerposition = yes
				}

				#debug
				instantTextboxType = {
					name = "limited_research_bonus_value"
					position = { x = 10000 y = 0 }
					font = Arialsmallcap
					text = "999"
					maxWidth = 50
					maxHeight = 20
				}
				instantTextboxType = {
					name = "research_speed_value"
					position = { x = 10000 y = 0 }
					font = Arial
					text = "999"
					maxWidth = 80
					maxHeight = 20
					format = right
				}

				#todo
				gridboxType = {
					name = "research_groups_grid"
					position = { x = -10000 y = 5 }
					size = { width = 192 height = 128 }
					slotsize = { width = 64 height = 64 }
					format = "RIGHT"
					max_slots_horizontal = 1
					max_slots_vertical = 8
				}
			}

			#research slots win
			@research_slot_width = 510
			@research_slot_height = 120
			containerWindowType = {
				name = "slots_window"
				position = { x = 20 y = 100 }
				size = { width = @research_slot_width height = -1 }
				#verticalScrollbar = "right_vertical_slider"
				background = {
					spriteType = GFX_tiled_null
					alwaystransparent = yes
				}
				gridboxType = {
					name = "research_slots_grid"
					size = { width = 100%% height = 100%% }
					slotsize = { width = @research_slot_width height = @research_slot_height }
					format = "UPPER_LEFT"
				}
			}
		}

		#todo
		containerWindowType = {
			name = "facilities"
			position = { x = -10000 y = 80 }
			size = { width = 550 height = -5 }

			# containerWindowType facilities_view (cf. facility_roster.gui) is embedded by code here
		}
	}

	#research slot win item entry
	containerWindowType = {
		name = "research_slot_entry"
		size = { width = @research_slot_width height = @research_slot_height }
		clipping = no
		background = {
			quadTextureSprite = GFX_research_line_bg
			clicksound = click_default
		}
		iconType = {
			name = "empty_research_slot_glow"
			spriteType = GFX_warning_red
			orientation = CENTER
			centerposition = yes
		}
		iconType = {
			name = "technology"
			position = { x = 252 y = 49 }
			spriteType = GFX_research_folder_strip
			centerposition = yes
			alwaystransparent = yes
		}
		iconType = {
			name = "designer"
			position = { x = 450 y = 49 }
			spriteType = GFX_research_folder_strip
			centerposition = yes
		}
		iconType = {
			name = "equipment"
			position = { x = 328 y = 27 }
			spriteType = GFX_land_equipment_role_icons
			frame = 1
		}
		iconType = {
			name = "carrier_fighter"
			position = { x = 349 y = 31 }
			spriteType = GFX_airwing_carrier_icon
		}
		instantTextboxType = {
			name = "title"
			position = { x = 15 y = 12 }
			font = Arialsmallcap
			maxWidth = 400
			maxHeight = 30
		}
		instantTextboxType = {
			name = "year"
			position = { x = 15 y = 60 }
			font = Arialsmallcap
			maxWidth = 50
			maxHeight = 22
		}
		instantTextboxType = {
			name = "eta"
			position = { x = 368 y = 12 }
			font = Arialsmallcap
			maxWidth = 125
			maxHeight = 20
			format = right
		}
		iconType = {
			name = "research_progressbar"
			spriteType = Gfx_research_progressbar
			position = { x = 0 y = -11 }
			orientation = CENTER_DOWN
			centerposition = yes
		}

		#debug
		iconType = {
			name = "research_progressbar_frame_icon"
			spriteType = GFX_research_progressbar_frame
			hide = yes
		}
	}
}
